# Copy to .env and adjust. docker-compose.yml and the backend both read it.

# Postgres container settings
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets
# 5433, not the default 5432, to avoid clashing with a Postgres installed on the host
POSTGRES_PORT=5433

# Redis container settings
REDIS_PORT=6379

# Backend settings (must match the values above)
DATABASE_URL=postgresql://tickets:tickets@localhost:5433/tickets
REDIS_URL=redis://localhost:6379/0

# How long a claimed seat is held before it goes back on sale (5 minutes)
HOLD_SECONDS=300

# How long a payment may take before the seat is released (5 minutes)
PAYMENT_SECONDS=300

# Declined payments allowed before the seat goes back on sale
MAX_PAYMENT_ATTEMPTS=3

# Signs queue tokens so bots can't forge them. Use any long random string, and keep it secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
QUEUE_SECRET=change-me-to-a-long-random-string

# How many buyers may be choosing seats at once (the rest wait in line)
ROOM_SIZE=100

# How long a buyer has to pick a seat once let in from the queue (5 minutes)
QUEUE_TOKEN_SECONDS=300
